{
  "name": "stalwart-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for Stalwart mailboxes on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env=\"\"",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply DB --env=\"\" --remote",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "depgraph": "madge --circular --extensions ts src",
    "check:brand": "bun run scripts/check-brand.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "madge": "^8.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.168.0"
  }
}
