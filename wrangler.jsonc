{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stalwart-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  // Invocation logs record request URLs, i.e. `/callback?code=…&state=…` and `/approve?h=…`:
  // off. The worker's own `console` output (fixed markers only) stays on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Fonts, artwork and icon of the pages shown in the browser (`public/brand`, see
  // src/oauth/theme.ts). Cloudflare serves these files itself, before the worker runs: they are
  // public and hold no data.
  "assets": { "directory": "./public" },
  // DEPLOYING YOUR OWN: change `routes`, the addresses and the name in `vars`, and the two
  // storage ids below. Everything else can stay as it is.
  "routes": [{ "pattern": "mail-mcp.exciting-it.com", "custom_domain": true }],
  // `vars` holds only what is fixed for a deployment and never tuned while it runs:
  //   ENVIRONMENT      "production". ("staging" makes a test deployment that only serves
  //                    allow-listed mailboxes; see "Trying it first" in the README.)
  //   STALWART_ORIGIN  the Stalwart server, an https origin
  //   PUBLIC_ORIGIN    this worker's own https origin (must match `routes`)
  //   CONNECTOR_NAME   the name AI tools show for the connector (optional)
  //   DATA_JURISDICTION  restricts where the mailbox vaults run and store data: "eu", "us" or
  //                    "fedramp" (optional). Choose it BEFORE the first sign-in: vault ids
  //                    depend on it, so a later change orphans every stored connection.
  // A variable declared here is rewritten on every deploy. What an operator sets or changes
  // while the worker runs lives in the Cloudflare dashboard instead, and `keep_vars` keeps it
  // there:
  //   STALWART_OAUTH_CLIENT_ID     OAuth client id of this worker at Stalwart (required)
  //   DISABLED_FEATURES            areas to switch off: "contacts", "calendars" or
  //                                "contacts,calendars" (optional; without it mail, contacts
  //                                and calendars are all offered)
  // Secrets (`wrangler secret put`, or the dashboard):
  //   STALWART_OAUTH_CLIENT_SECRET OAuth client secret at Stalwart (required)
  //   TOKEN_ENC_KEY                base64 of 32 random bytes; encrypts stored mailbox tokens
  //                                (required)
  // Until the client id and both secrets are set, every endpoint answers 503.
  "vars": {
    "ENVIRONMENT": "production",
    "STALWART_ORIGIN": "https://mail.exciting-it.com",
    "PUBLIC_ORIGIN": "https://mail-mcp.exciting-it.com",
    "CONNECTOR_NAME": "exciting IT Mail",
    "DATA_JURISDICTION": "eu"
  },
  // Create both once (README, "Deploying your own"), with a jurisdiction if you need one (it
  // can only be set at creation), and put the ids here. The ids are not secrets.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "bd3e1c010ab84025bb1e3fd67ee7bc4e" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stalwart-mcp",
      "database_id": "404b585c-6a33-4d22-87c0-baba2fe6b6b6",
      "migrations_dir": "migrations"
    }
  ],
  // Per source address, on the endpoints that need no sign-in (src/index.ts). `namespace_id` is
  // a number you choose: it names one counter set within your Cloudflare account, so the three
  // limiters must differ from each other and from the limiters of your other workers.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    { "name": "REGISTER_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    { "name": "TOKEN_RATE_LIMITER", "namespace_id": "1103", "simple": { "limit": 120, "period": 60 } }
  ],
  // Daily cleanup: audit rows older than 90 days and expired OAuth records.
  "triggers": { "crons": ["17 3 * * *"] },
  // One MailboxVault per Stalwart account id: the only holder of that mailbox's Stalwart tokens.
  "durable_objects": { "bindings": [{ "name": "MAILBOX_VAULT", "class_name": "MailboxVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxVault"] }]
}
